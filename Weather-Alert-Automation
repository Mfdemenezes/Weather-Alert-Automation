    {
      "parameters": {
        "jsCode": "// Processador meteorológico\nconst weatherData = $input.first().json;\n\n// Buscar dados de localização do nó anterior\nlet locationData;\ntry {\n  locationData = $('Merge Location Data').first().json;\n} catch (error) {\n  console.log('Nó Merge Location Data não encontrado, usando padrão');\n  locationData = { location: \"Localização atual\" };\n}\n\nconsole.log('🌡️ Processando dados meteorológicos...');\n\n// Configurações padrão\nconst defaultConfig = {\n  location: locationData.location || \"Localização atual\",\n  source: \"ios_address\",\n  telegram_bot_token: \"YOUR_TELEGRAM_BOT_TOKEN\",\n  telegram_chat_id: \"YOUR_TELEGRAM_CHAT_ID\",\n  user_preferences: {\n    rain_threshold: 40,\n    temp_cold: 16,\n    temp_hot: 32,\n    wind_threshold: 25\n  }\n};\n\n// Funções auxiliares\nfunction convertTimestamp(unixTimestamp) {\n  if (!unixTimestamp) return null;\n  return new Date(unixTimestamp * 1000).toISOString();\n}\n\nfunction windDirectionToText(degrees) {\n  if (degrees === null || degrees === undefined) return 'N/A';\n  \n  const directions = [\n    'Norte', 'Norte-Nordeste', 'Nordeste', 'Este-Nordeste',\n    'Este', 'Este-Sudeste', 'Sudeste', 'Sul-Sudeste',\n    'Sul', 'Sul-Sudoeste', 'Sudoeste', 'Oeste-Sudoeste',\n    'Oeste', 'Oeste-Noroeste', 'Noroeste', 'Norte-Noroeste'\n  ];\n  \n  const index = Math.round(degrees / 22.5) % 16;\n  return directions[index];\n}\n\nfunction calculateAdvancedRainProbability(weatherMain, clouds, humidity, visibility, pressure) {\n  let rainProb = 0;\n  \n  const main = weatherMain.toLowerCase();\n  if (main.includes('rain')) rainProb = 85;\n  else if (main.includes('drizzle')) rainProb = 65;\n  else if (main.includes('thunderstorm')) rainProb = 95;\n  else if (main.includes('clouds')) {\n    if (clouds > 90) rainProb = 50;\n    else if (clouds > 80) rainProb = 35;\n    else if (clouds > 60) rainProb = 20;\n    else if (clouds > 40) rainProb = 10;\n  } else if (main === 'clear') {\n    rainProb = 2;\n  }\n  \n  if (humidity > 90) rainProb += 25;\n  else if (humidity > 80) rainProb += 15;\n  else if (humidity > 70) rainProb += 8;\n  else if (humidity < 30) rainProb = Math.max(0, rainProb - 20);\n  \n  if (visibility < 1000) rainProb += 40;\n  else if (visibility < 5000) rainProb += 20;\n  else if (visibility < 8000) rainProb += 10;\n  \n  if (pressure < 1000) rainProb += 20;\n  else if (pressure < 1010) rainProb += 10;\n  else if (pressure > 1025) rainProb = Math.max(0, rainProb - 10);\n  \n  return Math.min(Math.max(Math.round(rainProb), 0), 100);\n}\n\nfunction calculateComfortIndex(temp, humidity) {\n  if (temp < 10) return 'Muito Frio';\n  if (temp < 16) return 'Frio';\n  if (temp < 24) return 'Confortável';\n  if (temp < 30) return 'Quente';\n  if (temp < 35) return 'Muito Quente';\n  return 'Extremamente Quente';\n}\n\n// Extração de dados\nconst coordinates = {\n  latitude: weatherData.coordenada?.lat || weatherData.coord?.lat || locationData.coordinates?.latitude || null,\n  longitude: weatherData.coordenada?.lon || weatherData.coord?.lon || locationData.coordinates?.longitude || null,\n  coordinates_string: locationData.coordinates || `${weatherData.coordenada?.lat || weatherData.coord?.lat || 0},${weatherData.coordenada?.lon || weatherData.coord?.lon || 0}`\n};\n\nconst temperature = {\n  current: weatherData.principal?.temporário || weatherData.main?.temp || null,\n  feels_like: weatherData.principal?.parece_que || weatherData.main?.feels_like || null,\n  min: weatherData.principal?.temp_min || weatherData.main?.temp_min || null,\n  max: weatherData.principal?.temp_máx || weatherData.main?.temp_max || null,\n  pressure: weatherData.principal?.pressão || weatherData.main?.pressure || null,\n  humidity: weatherData.principal?.umidade || weatherData.main?.humidity || null,\n  sea_level: weatherData.principal?.nível_do_mar || weatherData.main?.sea_level || null,\n  ground_level: weatherData.principal?.nível_grnd || weatherData.main?.grnd_level || null\n};\n\nconst wind = {\n  speed: weatherData.vento?.velocidade || weatherData.wind?.speed || 0,\n  direction_degrees: weatherData.vento?.graus || weatherData.wind?.deg || null,\n  direction_text: windDirectionToText(weatherData.vento?.graus || weatherData.wind?.deg),\n  gust: weatherData.vento?.rajada || weatherData.wind?.gust || null\n};\n\nconst visibility = {\n  meters: weatherData.visibilidade || weatherData.visibility || 10000,\n  kilometers: Math.round((weatherData.visibilidade || weatherData.visibility || 10000) / 1000 * 10) / 10,\n  clouds_percentage: weatherData.nuvens?.todos || weatherData.clouds?.all || 0\n};\n\nconst weather = {\n  id: weatherData.clima?.[0]?.eu_ia || weatherData.weather?.[0]?.id || null,\n  main: weatherData.clima?.[0]?.principal || weatherData.weather?.[0]?.main || 'Unknown',\n  description: weatherData.clima?.[0]?.descrição || weatherData.weather?.[0]?.description || 'Sem descrição',\n  icon: weatherData.clima?.[0]?.ícone || weatherData.weather?.[0]?.icon || null\n};\n\nconst system = {\n  country: weatherData.sistema?.país || weatherData.sys?.country || locationData.country_code || 'BR',\n  sunrise: weatherData.sistema?.nascer_do_sol || weatherData.sys?.sunrise || null,\n  sunset: weatherData.sistema?.pôr_do_sol || weatherData.sys?.sunset || null,\n  sunrise_iso: convertTimestamp(weatherData.sistema?.nascer_do_sol || weatherData.sys?.sunrise),\n  sunset_iso: convertTimestamp(weatherData.sistema?.pôr_do_sol || weatherData.sys?.sunset),\n  timezone: weatherData.fuso_horário || weatherData.timezone || locationData.timezone || -10800,\n  city_id: weatherData.eu_ia || weatherData.id || null,\n  city_name: weatherData.nome || weatherData.name || locationData.city || 'Cidade não identificada'\n};\n\nconst calculations = {\n  rain_probability: calculateAdvancedRainProbability(\n    weather.main, \n    visibility.clouds_percentage, \n    temperature.humidity, \n    visibility.meters, \n    temperature.pressure\n  ),\n  comfort_index: calculateComfortIndex(temperature.current, temperature.humidity),\n  dewpoint: Math.round(temperature.current - ((100 - temperature.humidity) / 5))\n};\n\nfunction determineUrgency() {\n  const temp = temperature.current;\n  const windSpeed = wind.speed;\n  const rainProb = calculations.rain_probability;\n  \n  if (temp <= 5 || temp >= 40 || windSpeed >= 50 || rainProb >= 80 || visibility.meters < 1000) {\n    return 'critical';\n  }\n  \n  if (temp <= defaultConfig.user_preferences.temp_cold || temp >= defaultConfig.user_preferences.temp_hot || \n      rainProb >= defaultConfig.user_preferences.rain_threshold || windSpeed >= defaultConfig.user_preferences.wind_threshold ||\n      visibility.meters < 5000) {\n    return 'high';\n  }\n  \n  if (temp <= defaultConfig.user_preferences.temp_cold + 2 || temp >= defaultConfig.user_preferences.temp_hot - 2 ||\n      rainProb >= defaultConfig.user_preferences.rain_threshold - 10 || windSpeed >= defaultConfig.user_preferences.wind_threshold - 5) {\n    return 'medium';\n  }\n  \n  return 'normal';\n}\n\n// Dados finais organizados\nconst processedData = {\n  current: {\n    temp: temperature.current,\n    feels_like: temperature.feels_like,\n    humidity: temperature.humidity,\n    pressure: temperature.pressure,\n    wind_speed: wind.speed,\n    main: weather.main,\n    description: weather.description,\n    temp_min: temperature.min,\n    temp_max: temperature.max\n  },\n  \n  conditions: {\n    rain_probability: calculations.rain_probability,\n    clouds_percentage: visibility.clouds_percentage,\n    visibility_meters: visibility.meters,\n    visibility_km: visibility.kilometers,\n    wind_direction: wind.direction_degrees,\n    wind_direction_text: wind.direction_text,\n    comfort_index: calculations.comfort_index\n  },\n  \n  location: locationData.location || defaultConfig.location,\n  coordinates: coordinates.coordinates_string,\n  city: system.city_name,\n  country: system.country,\n  \n  source: locationData.source || defaultConfig.source,\n  urgency: determineUrgency(),\n  timestamp: new Date().toISOString(),\n  \n  telegram_bot_token: defaultConfig.telegram_bot_token,\n  telegram_chat_id: defaultConfig.telegram_chat_id,\n  \n  location_details: {\n    search_location: locationData.search_location,\n    accuracy: locationData.accuracy,\n    timezone: locationData.timezone\n  },\n  \n  complete_data: {\n    coordinates: coordinates,\n    temperature: temperature,\n    wind: wind,\n    visibility: visibility,\n    weather: weather,\n    system: system,\n    calculations: calculations\n  }\n};\n\nreturn { json: processedData };"
      },
      "id": "51cc666f-f3f5-44b1-a4d9-92a9a0051ed5",
