    {
      "parameters": {
        "jsCode": "// Merge Location Data\nconsole.log('🔄 Executando Merge Location Data');\n\nconst allInputs = $input.all();\nconsole.log('📥 Total de inputs recebidos:', allInputs.length);\n\n// Buscar dados das diferentes fontes\nlet iosLocation = null;\nlet defaultLocation = null;\nlet configKeys = null;\n\nfor (const input of allInputs) {\n  if (input.json) {\n    console.log('🔍 Analisando input:', Object.keys(input.json));\n\n    if (input.json.source === 'ios_address') {\n      iosLocation = input.json;\n      console.log('📱 iOS Location encontrado');\n    }\n\n    if (input.json.default_location) {\n      defaultLocation = input.json;\n      console.log('🏠 Default Location encontrado');\n    }\n\n    if (input.json.openweather_api_key || input.json.telegram_bot_token) {\n      configKeys = input.json;\n      console.log('🔑 API Keys encontrado');\n    }\n  }\n}\n\nlet locationData;\n\n// Prioridade: iOS Location > Default Location\nif (iosLocation) {\n  console.log('🎯 Usando localização do iOS');\n  locationData = {\n    location: iosLocation.location,\n    search_location: iosLocation.search_location,\n    coordinates: iosLocation.coordinates,\n    timezone: iosLocation.timezone,\n    country_code: iosLocation.country_code,\n    source: 'ios_address',\n    accuracy: 'city',\n    city: iosLocation.city\n  };\n} else if (defaultLocation) {\n  console.log('🏠 Usando localização padrão');\n  locationData = {\n    location: defaultLocation.default_location,\n    search_location: defaultLocation.search_location || 'YOUR_DEFAULT_CITY,STATE,BR',\n    coordinates: {\n      lat: parseFloat(defaultLocation.default_lat),\n      lon: parseFloat(defaultLocation.default_lon)\n    },\n    timezone: defaultLocation.default_timezone,\n    country_code: 'BR',\n    source: 'default_config',\n    accuracy: 'manual',\n    city: 'YOUR_DEFAULT_CITY'\n  };\n} else {\n  console.log('⚠️ Usando fallback');\n  locationData = {\n    location: 'YOUR_DEFAULT_LOCATION',\n    search_location: 'YOUR_DEFAULT_CITY,STATE,BR',\n    coordinates: { lat: 0, lon: 0 },\n    timezone: 'America/Sao_Paulo',\n    country_code: 'BR',\n    source: 'fallback',\n    accuracy: 'manual',\n    city: 'YOUR_DEFAULT_CITY'\n  };\n}\n\n// Configurar preferências\nconst preferences = {\n  rain_threshold: 40,\n  temp_cold: 16,\n  temp_hot: 32,\n  wind_threshold: 25\n};\n\n// Usar chaves do iOS se disponível, senão do config, senão placeholder\nconst apiKey = iosLocation?.api_key || configKeys?.openweather_api_key || \"YOUR_OPENWEATHER_API_KEY\";\nconst telegramToken = iosLocation?.telegram_bot_token || configKeys?.telegram_bot_token || \"YOUR_TELEGRAM_BOT_TOKEN\";\nconst telegramChatId = iosLocation?.telegram_chat_id || configKeys?.telegram_chat_id || \"YOUR_TELEGRAM_CHAT_ID\";\n\nconsole.log('✅ Dados finais preparados:', locationData.source);\n\nreturn [{\n  json: {\n    ...locationData,\n    api_key: apiKey,\n    telegram_bot_token: telegramToken,\n    telegram_chat_id: telegramChatId,\n    user_preferences: preferences,\n    processed_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "9acb6cf4-e8c8-4021-bfc5-ac5fb429b338",
