    {
      "parameters": {
        "jsCode": "// Gerador de mensagens amigáveis para Telegram\nconst weatherData = $input.first().json;\n\nconsole.log('📱 Gerando mensagem amigável para Telegram...');\n\n// Funções auxiliares para mensagens dinâmicas\nfunction getGreeting() {\n  const hour = new Date().getHours();\n  if (hour < 6) return \"🌙 Boa madrugada\";\n  if (hour < 12) return \"🌅 Bom dia\";\n  if (hour < 18) return \"☀️ Boa tarde\";\n  return \"🌆 Boa noite\";\n}\n\nfunction getWeatherEmoji(main, description, clouds, rainProb) {\n  const mainLower = main.toLowerCase();\n  \n  if (mainLower.includes('rain')) return \"🌧️\";\n  if (mainLower.includes('drizzle')) return \"🌦️\";\n  if (mainLower.includes('thunderstorm')) return \"⛈️\";\n  if (mainLower.includes('snow')) return \"❄️\";\n  if (mainLower.includes('mist') || mainLower.includes('fog')) return \"🌫️\";\n  if (mainLower.includes('clear')) return \"☀️\";\n  if (mainLower.includes('clouds')) {\n    if (clouds > 80) return \"☁️\";\n    if (clouds > 50) return \"⛅\";\n    return \"🌤️\";\n  }\n  return \"🌤️\";\n}\n\nfunction getTemperatureComment(temp, feelsLike) {\n  if (temp <= 10) return \"🥶 Tá congelando! Bora se agasalhar bem!\";\n  if (temp <= 16) return \"🧥 Friozinho gostoso, uma blusa não faz mal!\";\n  if (temp <= 24) return \"😊 Temperatura perfeita para sair!\";\n  if (temp <= 30) return \"🌡️ Tá quentinho, mas nada demais!\";\n  if (temp <= 35) return \"🔥 Calor forte! Hidrate-se bem!\";\n  return \"🌋 Muito calor! Cuidado ao sair!\";\n}\n\nfunction getRainComment(rainProb, clouds) {\n  if (rainProb <= 10) return \"🌈 Céu tranquilo, pode sair sem guarda-chuva!\";\n  if (rainProb <= 30) return \"🤔 Pouquíssima chance de chuva, mas vai que...\";\n  if (rainProb <= 50) return \"☂️ Melhor levar um guarda-chuva, vai que cola!\";\n  if (rainProb <= 70) return \"🌧️ Boa chance de chuva, guarda-chuva é obrigatório!\";\n  if (rainProb <= 85) return \"⛈️ Vai chover! Prepare-se!\";\n  return \"🌊 Temporal chegando! Melhor ficar em casa!\";\n}\n\nfunction getUrgencyTip(urgency, temp, rainProb, windSpeed) {\n  switch (urgency) {\n    case 'critical':\n      return \"🚨 *ATENÇÃO MÁXIMA!* Condições extremas! Evite sair se possível!\";\n    case 'high':\n      return \"⚠️ *Cuidado redobrado!* Condições adversas, tome precauções extras!\";\n    case 'medium':\n      return \"⚡ *Fique atento!* Condições um pouco instáveis!\";\n    default:\n      return \"✅ *Tudo tranquilo!* Condições normais para atividades ao ar livre!\";\n  }\n}\n\nfunction getClothingSuggestion(temp, rainProb, windSpeed) {\n  let suggestion = \"👕 *Sugestão de look:* \";\n  \n  if (temp <= 10) {\n    suggestion += \"Casaco pesado, gorro e luvas! ❄️\";\n  } else if (temp <= 16) {\n    suggestion += \"Blusa de frio ou casaco! 🧥\";\n  } else if (temp <= 24) {\n    suggestion += \"Manga longa ou blusa leve! 👔\";\n  } else if (temp <= 30) {\n    suggestion += \"Camiseta confortável! 👕\";\n  } else {\n    suggestion += \"Roupa bem leve e clara! 🩱\";\n  }\n  \n  if (rainProb > 40) {\n    suggestion += \" + Guarda-chuva/capa! ☂️\";\n  }\n  \n  if (windSpeed > 15) {\n    suggestion += \" (Evite chapéus e objetos soltos!) 💨\";\n  }\n  \n  return suggestion;\n}\n\n// Construção da mensagem\nconst current = weatherData.current;\nconst conditions = weatherData.conditions;\nconst city = weatherData.city || \"sua localização\";\n\nconst greeting = getGreeting();\nconst weatherEmoji = getWeatherEmoji(current.main, current.description, conditions.clouds_percentage, conditions.rain_probability);\n\nlet message = `${greeting}! ${weatherEmoji}\\n\\n`;\nmessage += `🏙️ *Clima em ${city}*\\n`;\nmessage += `📅 ${new Date().toLocaleDateString('pt-BR',
