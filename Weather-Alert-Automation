      "parameters": {
        "jsCode": "// Process iOS Location - Versão para endereços\nconst data = $input.first().json.body || $input.first().json;\nconsole.log('📱 Dados recebidos do iPhone:', JSON.stringify(data, null, 2));\n\n// Função para extrair cidade do endereço\nfunction extractCityFromAddress(address) {\n  if (!address) return null;\n  \n  const parts = address.split(/,|\\n|\\r/).map(p => p.trim()).filter(p => p);\n  console.log('📍 Partes do endereço:', parts);\n  \n  for (let i = 0; i < parts.length; i++) {\n    const part = parts[i];\n    \n    if (part.match(/\\d{5}-?\\d{3}/) || \n        part.match(/^\\d+$/) || \n        part.toLowerCase().includes('rua') ||\n        part.toLowerCase().includes('avenida') ||\n        part.toLowerCase().includes('av.') ||\n        part.toLowerCase().includes('r.') ||\n        part.toLowerCase().includes('brazil') ||\n        part.toLowerCase().includes('brasil') ||\n        part.match(/^[A-Z]{2}$/) || \n        part.length < 3) {\n      continue;\n    }\n    \n    return part;\n  }\n  \n  return null;\n}\n\n// Função para detectar estado\nfunction extractStateFromAddress(address) {\n  if (!address) return 'RJ';\n  \n  const stateMatch = address.match(/\\b([A-Z]{2})\\b/);\n  if (stateMatch) {\n    return stateMatch[1];\n  }\n  \n  const stateNames = {\n    'rio de janeiro': 'RJ',\n    'são paulo': 'SP',\n    'minas gerais': 'MG',\n    'bahia': 'BA',\n    'paraná': 'PR',\n    'rio grande do sul': 'RS'\n  };\n  \n  for (const [name, code] of Object.entries(stateNames)) {\n    if (address.toLowerCase().includes(name)) {\n      return code;\n    }\n  }\n  \n  return 'RJ';\n}\n\n// Extrair endereço dos dados recebidos\nlet address = '';\n\nif (data.latitude && typeof data.latitude === 'string' && data.latitude.trim() !== '') {\n  address = data.latitude\n    .replace(/Latitude$/gi, '')\n    .replace(/Longitude$/gi, '')\n    .replace(/\\r\\n/g, ', ')\n    .replace(/\\n/g, ', ')\n    .replace(/\\r/g, ', ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n  console.log('📍 Endereço extraído do campo latitude:', address);\n} else if (data.longitude && typeof data.longitude === 'string' && data.longitude.trim() !== '') {\n  address = data.longitude\n    .replace(/Longitude$/gi, '')\n    .replace(/Latitude$/gi, '')\n    .replace(/\\r\\n/g, ', ')\n    .replace(/\\n/g, ', ')\n    .replace(/\\r/g, ', ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n  console.log('📍 Endereço extraído do campo longitude:', address);\n} else if (data.location && data.location !== 'Localização do iPhone') {\n  address = data.location;\n  console.log('📍 Endereço extraído do campo location:', address);\n} else if (data.address) {\n  address = data.address;\n  console.log('📍 Endereço extraído do campo address:', address);\n}\n\naddress = address.replace(/\\\\n/g, ' ')\n                .replace(/\\\\r/g, ' ')\n                .replace(/\\s+/g, ' ')\n                .trim();\n\nconsole.log('📍 Endereço bruto extraído:', address);\n\nif (!address || address === '') {\n  console.error('❌ Nenhum endereço foi encontrado nos dados recebidos');\n  console.log('🔍 Campos disponíveis:', Object.keys(data));\n  \n  throw new Error('Endereço não encontrado nos dados recebidos do iPhone. Verifique o atalho.');\n}\n\n// Extrair cidade e estado do endereço\nconst city = extractCityFromAddress(address);\nconst state = extractStateFromAddress(address);\n\nconsole.log('🏙️ Cidade detectada:', city);\nconsole.log('🗺️ Estado detectado:', state);\n\n// Se não conseguiu detectar cidade, usar o endereço completo como busca\nlet searchLocation;\nif (city) {\n  searchLocation = `${city},${state},BR`;\n} else {\n  searchLocation = `${address},BR`;\n}\n\nconsole.log('🔍 Busca API será:', searchLocation);\n\n// Coordenadas serão obtidas da API de clima\nconst coordinates = null;\n\n// Retornar dados processados\nreturn {\n  json: {\n    location: address,\n    search_location: searchLocation,\n    coordinates: coordinates,\n    city: city || 'Não detectada',\n    state: state,\n    timezone: 'America/Sao_Paulo',\n    country_code: 'BR',\n    source: 'ios_address',\n    accuracy: city ? 'city' : 'address',\n    // TODO: Configurar suas credenciais aqui\n    api_key: \"YOUR_OPENWEATHER_API_KEY\",\n    telegram_bot_token: \"YOUR_TELEGRAM_BOT_TOKEN\",\n    telegram_chat_id: \"YOUR_TELEGRAM_CHAT_ID\",\n    user_preferences: {\n      rain_threshold: 40,\n      temp_cold: 16,\n      temp_hot: 32,\n      wind_threshold: 25\n    },\n    received_address: address,\n    processed_at: new Date().toISOString(),\n    debug_info: {\n      original_data: data,\n      extracted_city: city,\n      extracted_state: state,\n      fields_received: Object.keys(data)\n    }\n  }\n};"
      },
